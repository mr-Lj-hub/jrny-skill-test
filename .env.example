PORT=3000

# ── Database (used by docker-compose to create the Postgres container) ──
POSTGRES_USER=taskflow_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=taskflow

# ── App database connection ──
# For local dev (no Docker):  postgresql://<user>:<password>@localhost:5432/taskflow
# For Docker Compose:         postgresql://taskflow_user:<password>@db:5432/taskflow
DATABASE_URL=postgresql://taskflow_user:CHANGE_ME@db:5432/taskflow

# ── Auth ──
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE
JWT_EXPIRES_IN=24h

# ── CORS ──
ALLOWED_ORIGINS=http://localhost:3000